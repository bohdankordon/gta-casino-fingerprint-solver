<?xml version="1.0" encoding="utf-8"?>
<!-- Based on the ui.wxf generated by Temurin/jpackage 21.0.6+7 x64 with
     the directory chooser enabled, WiX 3.14.1.8722. Keep jpackage's navigation.
     The application version token is XML-escaped by the packaging build. -->
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi" xmlns:util="http://schemas.microsoft.com/wix/UtilExtension">
  <Fragment>
    <Property Id="WIXUI_INSTALLDIR" Value="INSTALLDIR" />
    <Property Id="SOLVER_APPLICATION_VERSION" Value="@SOLVER_APPLICATION_VERSION@" />
    <Property Id="WIXUI_EXITDIALOGOPTIONALTEXT" Value="GTA Casino Fingerprint Solver was installed successfully. The application starts DISARMED and sends no gameplay input until you explicitly arm it." />
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOXTEXT" Value="Launch GTA Casino Fingerprint Solver" />
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOX" Value="1" />

    <!-- Standard MSI type 34, immediate, asynchronous, impersonated. The quoted
         path is relative to the stable INSTALLDIR, never a generated File ID.
         No sequence entry: only the successful ExitDialog Finish can call it. -->
    <CustomAction Id="SolverLaunchApplication" Directory="INSTALLDIR"
                  ExeCommand="&quot;[INSTALLDIR]GTA Casino Fingerprint Solver.exe&quot;"
                  Execute="immediate" Return="asyncNoWait" Impersonate="yes" />
    <UI Id="JpUI">
      <UIRef Id="WixUI_InstallDir" />
      <UIRef Id="WixUI_ErrorProgressText" />
      <DialogRef Id="InstallDirNotEmptyDlg" />
      <Publish Dialog="WelcomeDlg" Control="Next" Event="NewDialog" Value="InstallDirDlg" Order="6">NOT Installed</Publish>
      <Publish Dialog="InstallDirDlg" Control="Back" Event="NewDialog" Value="WelcomeDlg" Order="6">NOT Installed</Publish>
      <!-- ExitDialog is scheduled only OnExit=success by standard WixUI.
           A major upgrade installs a new ProductCode (NOT Installed), so it is
           eligible too. Maintenance, removal, reduced/silent UI and elevated
           sessions cannot launch. Order 1 runs before Finish's Return (999). -->
      <Publish Dialog="ExitDialog" Control="Finish" Event="DoAction" Value="SolverLaunchApplication" Order="1"><![CDATA[WIXUI_EXITDIALOGOPTIONALCHECKBOX = 1 AND UILevel = 5 AND ACTION = "INSTALL" AND NOT Installed AND NOT REMOVE AND NOT UPGRADINGPRODUCTCODE AND NOT MsiRunningElevated]]></Publish>
    </UI>
  </Fragment>
</Wix>
