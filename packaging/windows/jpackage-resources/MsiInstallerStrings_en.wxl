  <!-- Standard WiX localization overrides: no replacement dialogs or navigation. -->
  <String Id="WelcomeDlgDescription">Version [SOLVER_APPLICATION_VERSION]&#13;&#10;&#13;&#10;Setup includes a private Temurin 21 Java runtime, OpenCV/native dependencies and Start Menu integration.&#13;&#10;&#13;&#10;All required runtime components are included. No separate Java or OpenCV installation is required.&#13;&#10;&#13;&#10;Click Next to continue.</String>
  <UI Dialog="WelcomeDlg" Control="Description" Height="140" />
  <String Id="VerifyReadyDlgInstallText">Version: [SOLVER_APPLICATION_VERSION]&#13;&#10;Installation: current user&#13;&#10;Private Java runtime: included&#13;&#10;OpenCV/native dependencies: included&#13;&#10;Start Menu shortcut: included&#13;&#10;Additional downloads: none&#13;&#10;&#13;&#10;Click Install to begin, or Back to review your settings.</String>
  <UI Dialog="VerifyReadyDlg" Control="InstallText" Height="140" />
